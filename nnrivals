--  [10] AIMBOT
-- ═══════════════════════════════════════════════════════════════
local AimbotConn

local function StartAimbot()
    if AimbotConn then AimbotConn:Disconnect() end
    AimbotConn = RunService.RenderStepped:Connect(function()
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        SetFovPos(center, State.AimbotFOV)
        SetFovVisible(State.AimbotEnabled)

        if not State.AimbotEnabled then return end
        if not UserInputService:IsKeyDown(State.AimbotKey) then return end

        local hit = GetNearest(State.AimbotFOV, State.AimbotPart)
        if not hit then return end

        local targetPos = hit.part.Position

        -- velocity prediction
        if State.AimbotPrediction then
            pcall(function()
                local root = GetRoot(GetChar(hit.player))
                if root then
                    local vel = root.AssemblyLinearVelocity
                        or root.Velocity
                        or Vector3.zero
                    targetPos = targetPos + vel * 0.083
                end
            end)
        end

        pcall(function()
            local currentCF = Camera.CFrame
            local targetCF  = CFrame.lookAt(currentCF.Position, targetPos)
            Camera.CFrame   = currentCF:Lerp(
                targetCF,
                math.clamp(State.AimbotSmoothing, 0.01, 1.0)
            )
        end)
    end)
end

