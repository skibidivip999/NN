-- ═══════════════════════════════════════════════════════════════
local AutoshootConn

local function StartAutoshoot()
    if AutoshootConn then AutoshootConn:Disconnect() end
    AutoshootConn = RunService.Heartbeat:Connect(function()
        if not State.Autoshoot or State.AutoshootCD then return end

        local hit = GetNearest(State.AutoshootRange, State.AimbotPart)
        if not hit then return end

        State.AutoshootCD = true
        pcall(function()
            local char   = GetChar(LocalPlayer)
            local tool   = char and char:FindFirstChildOfClass("Tool")
            local remote = tool and GetFireRemote(tool)
            if remote then
                remote:FireServer(hit.part.Position)
            else
                SafeClick()
            end
        end)
        task.delay(0.12, function() State.AutoshootCD = false end)
    end)
end

-- ═══════════════════════════════════════════════════════════════
--  [14] FASTER RELOAD
-- ═══════════════════════════════════════════════════════════════
local function ApplyFasterReload()
    pcall(function()
        local char = GetChar(LocalPlayer)
        if not char then return end

        -- speed up playing animation tracks
        local hum = GetHum(char)
        if hum then
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.Name and track.Name:lower():find("reload") then
                        track:AdjustSpeed(State.ReloadMultiplier)
                    end
                end
            end
        end

        -- patch numeric reload values in tools
        for _, tool in ipairs(char:GetChildren()) do
            if not tool:IsA("Tool") then continue end
            local cfg = tool:FindFirstChild("Config")
                or tool:FindFirstChild("Settings")
                or tool
            for _, val in ipairs(cfg:GetDescendants()) do
                if val:IsA("NumberValue") or val:IsA("IntValue") then
                    if val.Name:lower():find("reload") then
                        val.Value = val.Value / State.ReloadMultiplier
                    end
                end
            end
        end
    end)
end

