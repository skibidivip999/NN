-- find the primary fire remote in a tool
local fireNames = {
    "fire","shoot","attack","bullet","hit",
    "damage","shoot_event","fireserver",
}
local function GetFireRemote(tool)
    if not tool then return nil end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n = d.Name:lower()
            for _, fn in ipairs(fireNames) do
                if n:find(fn) then return d end
            end
        end
    end
    -- fallback: first RemoteEvent
    return tool:FindFirstChildWhichIsA("RemoteEvent", true)
end

