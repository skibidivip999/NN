--  [0]  SILENT ANTI-CHEAT BYPASS
--       Chạy ngay lập tức — không UI — không thể tắt
-- ═══════════════════════════════════════════════════════════════
;(function()
    local Players     = game:GetService("Players")
    local LP          = Players.LocalPlayer
    local WS          = game:GetService("Workspace")
    local protected   = {}

    -- executor capability flags
    local HAS_HOOK    = (hookfunction  ~= nil)
    local HAS_NCC     = (newcclosure   ~= nil)
    local HAS_GMM     = (getrawmetatable ~= nil and setreadonly ~= nil)
    local HAS_GC      = (getgc         ~= nil)
    local HAS_GCONN   = (getconnections ~= nil)
    local HAS_SYN     = (syn           ~= nil and syn.protect_gui ~= nil)

    -- helper: safe hook
    local function safeHook(fn, replacement)
        if HAS_HOOK and HAS_NCC then
            pcall(function() hookfunction(fn, newcclosure(replacement)) end)
        end
    end

    -- 0-A  Metamethod shield ─────────────────────────────────────
    if HAS_GMM then
        pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local _ni = mt.__newindex
            mt.__newindex = newcclosure(function(self, k, v)
                local block = {WalkSpeed=true, JumpPower=true}
                if block[k] then return end
                return _ni(self, k, v)
            end)
            setreadonly(mt, true)
        end)
    end

    -- 0-B  Kick swallow ──────────────────────────────────────────
    pcall(function()
        local _kick = LP.Kick
        safeHook(_kick, function(self, ...)
            if self == LP then return end
            return _kick(self, ...)
        end)
    end)

    -- 0-C  Remote disabler (async, no lag) ───────────────────────
    local acPat = {
        "kick","ban","detect","cheat","exploit","flag",
        "report","anticheat","anti_cheat","punish","sanction",
        "terminate","speedcheck","integ","raycheck",
    }
    local function isAC(name)
        name = name:lower()
        for _, p in ipairs(acPat) do
            if name:find(p) then return true end
        end
        return false
    end
    local function disableRemote(d)
        if not (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then return end
        if not isAC(d.Name) then return end
        if HAS_GCONN then
            pcall(function()
                for _, c in ipairs(getconnections(d.OnClientEvent)) do
                    pcall(function() c:Disable() end)
                end
            end)
            pcall(function()
                for _, c in ipairs(getconnections(d.OnClientInvoke)) do
                    pcall(function() c:Disable() end)
                end
            end)
        end
    end
    -- scan async so execute doesn't freeze
    task.spawn(function()
        for _, d in ipairs(game:GetDescendants()) do
            disableRemote(d)
            task.wait()   -- yield each iteration — zero lag
        end
    end)
    table.insert(protected, game.DescendantAdded:Connect(function(d)
        task.defer(function() disableRemote(d) end)
    end))

    -- 0-D  GC scanner kill (async) ───────────────────────────────
    if HAS_GC then
        task.spawn(function()
            local kill = {
                "detect","cheat","exploit","scanner",
                "anticheat","getgenv","gethui","isexploit",
            }
            local gc = getgc(true)
            for _, v in ipairs(gc) do
                if type(v) == "function" then
                    pcall(function()
                        local info = debug.getinfo(v, "n")
                        if info and info.name then
                            local n = info.name:lower()
                            for _, p in ipairs(kill) do
                                if n:find(p) then
                                    safeHook(v, function() return nil end)
                                    break
                                end
                            end
                        end
                    end)
                end
                task.wait()
            end
        end)
    end

    -- 0-E  AC script disabler ────────────────────────────────────
    local scriptKill = {
        "anticheat","anti_cheat","cheatdetect","exploitdetect",
        "hackdetect","integritycheck","speedcheck","teleportcheck",
    }
    local function isACScript(name)
        name = name:lower():gsub("[%s%-_]","")
        for _, kw in ipairs(scriptKill) do
            if name:find(kw) then return true end
        end
        return false
    end
    local function killScript(obj)
        if (obj:IsA("LocalScript") or obj:IsA("ModuleScript")) and isACScript(obj.Name) then
            pcall(function() obj.Disabled = true end)
        end
    end
    task.spawn(function()
        for _, obj in ipairs(game:GetDescendants()) do
            killScript(obj)
            task.wait()
        end
    end)
    table.insert(protected, game.DescendantAdded:Connect(function(obj)
        task.defer(function() killScript(obj) end)
    end))

    -- 0-F  Camera lock protection ────────────────────────────────
    pcall(function()
        local cam = WS.CurrentCamera
        cam.CameraType = Enum.CameraType.Custom
        table.insert(protected,
            cam:GetPropertyChangedSignal("CameraType"):Connect(function()
                pcall(function() cam.CameraType = Enum.CameraType.Custom end)
            end)
        )
    end)

    -- 0-G  GUI protection ────────────────────────────────────────
    local function protectGUI(gui)
        pcall(function()
            if HAS_SYN then syn.protect_gui(gui) end
            if gui:IsA("ScreenGui") then
                gui.ResetOnSpawn = false
            end
        end)
    end
    pcall(function()
        for _, gui in ipairs(LP.PlayerGui:GetChildren()) do
            protectGUI(gui)
        end
        table.insert(protected, LP.PlayerGui.ChildAdded:Connect(function(child)
            task.defer(function() protectGUI(child) end)
        end))
    end)
    pcall(function()
        if gethui then
            for _, gui in ipairs(gethui():GetChildren()) do
                protectGUI(gui)
            end
        end
    end)

    -- 0-H  Respawn persistence ───────────────────────────────────
    table.insert(protected, LP.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        task.spawn(function()
            for _, d in ipairs(game:GetDescendants()) do
                disableRemote(d)
            end
        end)
        pcall(function() char:FindFirstChildOfClass("Humanoid") end)
    end))

    -- 0-I  Periodic re-apply every 30s ───────────────────────────
    task.spawn(function()
        while true do
            task.wait(30)
            task.spawn(function()
                for _, d in ipairs(game:GetDescendants()) do
                    disableRemote(d)
                    task.wait()
                end
            end)
        end
    end)

end)()  -- end bypass IIFE

