local TriggerbotConn

local function StartTriggerbot()
    if TriggerbotConn then TriggerbotConn:Disconnect() end
    TriggerbotConn = RunService.Heartbeat:Connect(function()
        if not State.Triggerbot then return end
        if State.TriggerCooldown then return end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { GetChar(LocalPlayer) }

        local result = Workspace:Raycast(
            Camera.CFrame.Position,
            Camera.CFrame.LookVector * 1200,
            params
        )
        if not result then return end

        local model  = result.Instance:FindFirstAncestorOfClass("Model")
        local player = model and Players:GetPlayerFromCharacter(model)
        if not (player and player ~= LocalPlayer and IsAlive(player)) then return end

        State.TriggerCooldown = true
        task.delay(State.TriggerDelay, function()
            -- fire via remote or mouse click
            pcall(function()
                local char   = GetChar(LocalPlayer)
                local tool   = char and char:FindFirstChildOfClass("Tool")
                local remote = tool and GetFireRemote(tool)
                if remote then
                    remote:FireServer(result.Position)
                else
                    SafeClick()
                end
            end)
            task.wait(0.05)
            State.TriggerCooldown = false
        end)
    end)
end

-- ═══════════════════════════════════════════════════════════════
--  [12] SILENT AIM
--       Hook approach: redirect FireServer position arg
--       Works without hooking C-side Workspace.Raycast
-- ═══════════════════════════════════════════════════════════════
local SilentHooked = {}

local function HookToolForSilent(tool)
    if not tool or not tool:IsA("Tool") then return end
    if SilentHooked[tool] then return end
    SilentHooked[tool] = true

    local function hookRemote(remote)
        if not remote or not remote:IsA("RemoteEvent") then return end
        local _old = remote.FireServer
        remote.FireServer = newcclosure and newcclosure(function(self, ...)
            if State.SilentAim then
                local target = GetNearest(State.AimbotFOV, State.SilentPart)
                if target then
                    local args    = { ... }
                    -- first positional arg is almost always the hit position
                    args[1]       = target.part.Position
                    return _old(self, table.unpack(args))
                end
            end
            return _old(self, ...)
        end) or function(self, ...)
            if State.SilentAim then
                local target = GetNearest(State.AimbotFOV, State.SilentPart)
                if target then
                    local args = { ... }
                    args[1]    = target.part.Position
                    return _old(self, table.unpack(args))
                end
            end
            return _old(self, ...)
        end
    end

    for _, desc in ipairs(tool:GetDescendants()) do
        hookRemote(desc)
    end
    tool.DescendantAdded:Connect(hookRemote)
end

local function ApplySilentAim()
    pcall(function()
        local char = GetChar(LocalPlayer)
        if not char then return end
        for _, tool in ipairs(char:GetChildren()) do
            HookToolForSilent(tool)
        end
    end)
end

-- watch for new tools equipped (covers respawn + mid-game equip)
local function WatchForTools(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            if State.SilentAim then HookToolForSilent(child) end
            if State.RapidFire  then PatchToolRapidFire(child) end
        end
    end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.1)
            if State.SilentAim then HookToolForSilent(child) end
            if State.RapidFire  then PatchToolRapidFire(child) end
        end
    end)
end

