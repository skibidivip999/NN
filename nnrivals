--  [7]  WALLBANG
-- ═══════════════════════════════════════════════════════════════
local WallbangConn

local function CastThrough(origin, dir, maxDist, maxPen)
    local hits    = {}
    local params  = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { GetChar(LocalPlayer) }
    params.FilterDescendantsInstances = excluded

    local curOrigin = origin
    local remaining = maxDist
    local pen       = 0

    while pen < maxPen and remaining > 0 do
        local result = Workspace:Raycast(curOrigin, dir.Unit * remaining, params)
        if not result then break end

        local model  = result.Instance:FindFirstAncestorOfClass("Model")
        local player = model and Players:GetPlayerFromCharacter(model)
        if player and player ~= LocalPlayer and IsAlive(player) then
            table.insert(hits, { player = player, position = result.Position })
        end

        remaining   = remaining - (result.Position - curOrigin).Magnitude - 0.3
        curOrigin   = result.Position + dir.Unit * 0.3
        table.insert(excluded, result.Instance)
        params.FilterDescendantsInstances = excluded
        pen = pen + 1
    end
    return hits
end

local function StartWallbang()
    if WallbangConn then
        WallbangConn:Disconnect()
        WallbangConn = nil
    end
    if not State.Wallbang then return end

    WallbangConn = RunService.Heartbeat:Connect(function()
        if not State.Wallbang then return end
        local origin = Camera.CFrame.Position
        local dir    = Camera.CFrame.LookVector
        local hits   = CastThrough(origin, dir, 600, State.WallbangMaxPen)

        for _, hit in ipairs(hits) do
            pcall(function()
                local remoteNames = {
                    "FireBullet","DamagePlayer","Damage",
                    "BulletHit","Hit","TakeDamage",
                }
                for _, rn in ipairs(remoteNames) do
                    local remote = ReplicatedStorage:FindFirstChild(rn, true)
                    if remote and remote:IsA("RemoteEvent") then
                        remote:FireServer(hit.player, hit.position)
                        break
                    end
                end
            end)
        end
    end)
end

