LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.8)
    WatchForTools(char)
    if State.RapidFire    then ApplyRapidFire()    end
    if State.FasterReload then ApplyFasterReload()  end
    if State.SilentAim    then ApplySilentAim()     end
    if State.SkinUnlocker then ApplySkinUnlocker()  end
    if State.Wallbang     then StartWallbang()       end
end)

-- hook current character immediately
pcall(function()
    local char = GetChar(LocalPlayer)
    if char then WatchForTools(char) end
end)

